---
import { homepageFeatures } from "@/config/product";
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="section-heading">
    <p class="eyebrow">Core creative tools</p>
    <h2 id="features-title">Make AI visuals without starting from a blank page.</h2>
    <p>PicMuse brings the most useful creation paths into one Android app, from video generation to photo editing and trend-led templates.</p>
  </div>
  <div class="feature-grid">
    {homepageFeatures.map((feature) => (
      <article class="feature-card">
        <span>{feature.tag}</span>
        <h3>{feature.name}</h3>
        <p>{feature.summary}</p>
      </article>
    ))}
  </div>
</section>

